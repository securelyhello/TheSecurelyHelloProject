{
  "name": "securelyhello-server",
  "version": "1.0.0",
  "private": true,
  "description": "Securely Hello directory, signaling switchboard and ciphertext relay queue",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",

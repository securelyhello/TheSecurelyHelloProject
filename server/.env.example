# Postgres (durable directory: accounts, sessions, keys, contacts).
#   Neon (production): use the POOLED connection string
#     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#   Local Docker (scripts/dev.sh): postgresql://sh:sh_dev_password@127.0.0.1:55432/securelyhello
DATABASE_URL=

# Redis (presence, rate limits, caches, 24 h ciphertext relay queue).
#   docker-compose.yml sets this to the bundled redis service.
#   Local Docker (scripts/dev.sh): redis://127.0.0.1:56379/0
REDIS_URL=

# HTTP + WebSocket listen address.
HOST=0.0.0.0
PORT=8787

# Number of reverse-proxy hops in front of the server that set
# X-Forwarded-For (Traefik under Coolify = 1). 0 when clients connect directly.
TRUST_PROXY=0

# Apply pending migrations on start (safe to leave on; uses an advisory lock).
MIGRATE_ON_START=1
# Optional: Neon's direct (non-pooled) URL for migrations. Defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=

# Transactional e-mail (password-reset and verification codes).
#   EMAIL_PROVIDER must be `resend` or `brevo` to send anything. The default,
#   `log`, is a dry-run whatever else is set (an EMAIL_API_KEY alone does not
#   enable sending), and in production (NODE_ENV=production) it is logged as a
#   warning at startup. A missing EMAIL_API_KEY or EMAIL_FROM, or an unknown
#   provider, also falls back to dry-run with a warning. Outside production
#   dry-run prints the recipient and code to stdout, which is what local
#   development uses.
#   EMAIL_FROM must be an address on thenn.in itself (not a subdomain), because
#   the domain's DMARC policy is strict, e.g. "Securely Hello <no-reply@thenn.in>".
#   EMAIL_API_KEY is secret: set it in server/.env or the host's environment,
#   never in the app's root .env.
#   EMAIL_DAILY_CAP: global sends per 24 h (sliding window), default 90,
#   minimum 2 (lower values are raised to 2 with a warning). Verification
#   e-mails stop at 2/3 of it (60 at the default, 26 at 40) so resets keep
#   working. Fixed per-sender limits on top: password-reset requests 3/h and
#   5/day per e-mail address, 5/h and 20/day per IP; verification requests
#   3/h per account. While a code is live and under 60 s old, asking again
#   answers the same 200 without sending a new one.
EMAIL_PROVIDER=log
EMAIL_FROM=
EMAIL_API_KEY=
# EMAIL_DAILY_CAP=90

# HMAC-SHA256 key for the stored e-mail code hashes. Generate with
#   openssl rand -hex 32
# Optional: when unset the server uses a random key per process (a warning is
# logged in production), so a restart only invalidates codes that are still
# live (30 min at most). Set it when running more than one instance.
CODE_HMAC_KEY=

# TURN relay credentials for clients behind strict NAT (coturn REST auth,
# `use-auth-secret`). GET /api/turn hands each signed-in user a short-lived
# username/credential derived from TURN_SECRET. Leave TURN_SECRET empty to
# disable: TURN is off when TURN_SECRET or TURN_URLS is empty (the endpoint
# then returns {"urls":[],"ttl":0}).
#   TURN_SECRET must equal coturn's `static-auth-secret`. Secret: never commit it.
#   TURN_URLS: comma-separated, e.g.
#     turn:turn.thenn.in:3478?transport=udp,turn:turn.thenn.in:3478?transport=tcp
#   TURN_TTL_SECONDS: lifetime of issued credentials in seconds, default 3600.
#   The app refreshes them 5 min before expiry (or at half the TTL if that is
#   sooner).
TURN_SECRET=
TURN_URLS=
# TURN_TTL_SECONDS=3600

# Optional tuning (defaults shown).
# SESSION_TTL_DAYS=90
# RELAY_TTL_HOURS=24
# DB_POOL_MAX=10
# REDIS_PREFIX=sh:
# LOG_LEVEL=info
# LOG_REQUESTS=1

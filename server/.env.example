# Postgres (durable directory: accounts, sessions, keys, contacts).
#   Neon (production): use the POOLED connection string
#     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#   Local Docker (scripts/dev.sh): postgresql://sh:sh_dev_password@127.0.0.1:55432/securelyhello
DATABASE_URL=

# Redis (presence, rate limits, caches, 24 h ciphertext relay queue).
#   docker-compose.yml sets this to the bundled redis service.
#   Local Docker (scripts/dev.sh): redis://127.0.0.1:56379/0
REDIS_URL=

# HTTP + WebSocket listen address.
HOST=0.0.0.0
PORT=8787

# Number of reverse-proxy hops in front of the server that set
# X-Forwarded-For (Traefik under Coolify = 1). 0 when clients connect directly.
TRUST_PROXY=0

# Apply pending migrations on start (safe to leave on; uses an advisory lock).
MIGRATE_ON_START=1
# Optional: Neon's direct (non-pooled) URL for migrations. Defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=

# Optional tuning (defaults shown).
# SESSION_TTL_DAYS=90
# RELAY_TTL_HOURS=24
# DB_POOL_MAX=10
# REDIS_PREFIX=sh:
# LOG_LEVEL=info
# LOG_REQUESTS=1

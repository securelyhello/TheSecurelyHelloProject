# Postgres (durable directory: accounts, sessions, keys, contacts).
#   Neon (production): use the POOLED connection string
#     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#   Local Docker (scripts/dev.sh): postgresql://sh:sh_dev_password@127.0.0.1:55432/securelyhello
DATABASE_URL=

# Redis (presence, rate limits, caches, 24 h ciphertext relay queue).
#   docker-compose.yml sets this to the bundled redis service.
#   Local Docker (scripts/dev.sh): redis://127.0.0.1:56379/0
REDIS_URL=

# HTTP + WebSocket listen address.
HOST=0.0.0.0
PORT=8787

# Number of reverse-proxy hops in front of the server that set
# X-Forwarded-For (Traefik under Coolify = 1). 0 when clients connect directly.
TRUST_PROXY=0

# Apply pending migrations on start (safe to leave on; uses an advisory lock).
MIGRATE_ON_START=1
# Optional: Neon's direct (non-pooled) URL for migrations. Defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=

# E-mail for verification and password-reset codes.
#   MAIL_TRANSPORT: smtp | file | log | none
#   (default: smtp when SMTP_URL is set, otherwise log outside production and
#   none in production, where codes must never reach the logs)
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Securely Hello <no-reply@example.com>
# MAIL_FILE_DIR=/tmp/sh_mail        # with MAIL_TRANSPORT=file (tests)
# EMAIL_VERIFICATION=required       # required | optional (default: required with SMTP)
# Most e-mails sent in any 24 h (sliding window), all kinds together; keep it
# under the provider's daily quota minus anything else sharing it.
# Verification mail stops at floor(2/3 of the cap); the rest is kept for
# password resets and device recovery. Over the cap, sign-up still answers
# 201 (no mail sent), password reset still answers 202 but sends nothing,
# and resending verification / device recovery answer 503 email_unavailable.
# Minimum 2 (lower values are raised to 2 with a warning).
EMAIL_DAILY_CAP=40

# Push wake-ups (Firebase Cloud Messaging HTTP v1): the service-account JSON,
# inline, base64-encoded, or a path. Pushes never carry message content.
# FCM_SERVICE_ACCOUNT=<service-account JSON, inline or base64>

# Moderation API (/api/admin/*): at least 32 random characters.
# ADMIN_TOKEN=

# Encrypts two-step verification (TOTP) secrets at rest. Long random string;
# keep it safe: losing it locks out users who turned two-step on.
# TOTP_ENCRYPTION_KEY=

# Invite links: the token is appended. Point it at the website's /i/ page.
# INVITE_BASE_URL=https://securelyhello.thenn.in/i/

# Spam controls: proof-of-work bits for signup/reset (0 = off), throwaway
# e-mail domains (refused unless 0), extra domains to refuse.
# POW_BITS=18
# BLOCK_DISPOSABLE_EMAIL=1
# DISPOSABLE_DOMAINS_FILE=/etc/securelyhello/disposable.txt

# Encrypted attachments (ciphertext blobs in Postgres).
# ATTACHMENT_STORAGE=postgres     # postgres | filesystem | s3
# ATTACHMENT_DIR=/data/attachments  # with filesystem
# S3_ENDPOINT=https://s3.example.com  S3_BUCKET=…  S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=…  S3_SECRET_ACCESS_KEY=…  S3_PATH_STYLE=1
# ATTACHMENT_MAX_MB=16
# ATTACHMENT_TTL_DAYS=30
# ATTACHMENT_QUOTA_MB=512

# Optional tuning (defaults shown).
# SESSION_TTL_DAYS=90
# RELAY_TTL_HOURS=24
# DB_POOL_MAX=10
# REDIS_PREFIX=sh:
# LOG_LEVEL=info
# LOG_REQUESTS=1

# Prometheus metrics at GET /metrics, scraped with this bearer token.
# METRICS_TOKEN=…

# TURN relay for calls behind strict NATs (see DEPLOY.md, Calls and TURN).
# The app gets short-lived credentials signed with TURN_SECRET.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_SECRET=…
# TURN_TTL_HOURS=12               # production uses 1

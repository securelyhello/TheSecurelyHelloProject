# App configuration. This file is bundled INSIDE the app as an asset, so
# anyone with the APK / IPA can read it. Never put long-lived secrets here
# (no TURN passwords, service-account keys or admin tokens).

# Securely Hello server (see server/). Must be https:// in production.
# Release builds use https://api.hello.thenn.in when this is empty or unset;
# debug builds fall back to the local dev server.
#   Local dev (scripts/dev.sh):  http://127.0.0.1:8787   (Android emulator: http://10.0.2.2:8787)
API_BASE_URL=https://api.hello.thenn.in

# Optional certificate pins (comma-separated base64 SHA-256 of the server's
# public key, current + backup). Off when empty; see server/DEPLOY.md first.
# API_CERT_PINS=

# Optional static TURN relay. Prefer TURN_SECRET on the server: the app then
# fetches short-lived credentials from GET /api/turn and these stay empty.
# A TURN_CREDENTIAL put here ships inside the app and never expires.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: push wake-ups on Android / iOS (Firebase Cloud Messaging).
# Desktop builds don't need this. Values come from your Firebase project's
# settings (Android app and iOS bundle both registered as
# securelyhello.thenn.in); the server additionally needs FCM_SERVICE_ACCOUNT
# (see server/DEPLOY.md). Rebuild the app after changing them. These are
# client identifiers, not secrets. Pushes never carry message content.
# Leave empty to disable.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=

# Securely Hello server (see server/). Must be https:// in production.
#   Local dev (scripts/dev.sh):  http://127.0.0.1:8787   (Android emulator: http://10.0.2.2:8787)
API_BASE_URL=https://api.hello.thenn.in

# Optional static TURN override. Normally leave these empty: the app fetches
# short-lived TURN credentials from the server (GET /api/turn). These are only
# used as a fallback if that fetch fails. Comma-separated URLs.
# This file ships inside the app, so anyone can read these values: never put
# a real long-term TURN credential (or coturn's static-auth-secret) here.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# E-mail (password reset, verification) is configured on the server only, in
# server/.env. This file is bundled into the app: never put API keys here.

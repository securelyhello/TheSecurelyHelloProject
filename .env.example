# Securely Hello server (see server/). Must be https:// in production.
#   Local dev (scripts/dev.sh):  http://127.0.0.1:8787   (Android emulator: http://10.0.2.2:8787)
API_BASE_URL=https://api.hello.thenn.in

# Optional TURN relay for peers behind strict NAT (comma-separated URLs)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: push wake-ups on Android / iOS (Firebase Cloud Messaging).
# Desktop builds don't need this. Values come from your Firebase project's
# settings; the server additionally needs FCM_SERVICE_ACCOUNT (see server/).
# Pushes never carry message content. Leave empty to disable.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=

<?xml version="1.0" encoding="utf-8"?>
<!-- Platform networking (Firebase, WebRTC's helpers): TLS only and no
     user-installed CAs. Debug builds override this file with
     src/debug/res/xml/network_security_config.xml, which also allows
     cleartext to the local development server. The Dart HTTP client
     enforces its own rules (DirectoryService.parseBaseUrl). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
